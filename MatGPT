import discord
import random
import os
import requests
from discord.ext import commands
print(os.listdir('images'))

intents = discord.Intents.default()
intents.message_content = True

bot = commands.Bot(command_prefix='#', intents=intents)

@bot.event
async def on_ready():
    print(f'We have logged in as {bot.user}')

@bot.command()
async def hello(ctx):
    await ctx.send(f'Hola, soy un bot {bot.user}!')

@bot.command()
async def heh(ctx, count_heh = 5):
    await ctx.send("he" * count_heh)

@bot.command()
async def Matteo(ctx):
    await ctx.send(f"Matteo es programador")

@bot.command()
async def suma(ctx, num1: int, num2: int):
    await ctx.send(f"la suma de {num1} y {num2} es igual {num1 + num2}")

@bot.command()
async def choose(ctx, *choices: str):
    """Chooses between multiple choices."""
    await ctx.send(random.choice(choices))

@bot.command()
async def repeat(ctx, times: int, content='repeating...'):
    """Repeats a message multiple times."""
    for i in range(times):
        await ctx.send(content)

@bot.command()
async def joined(ctx, member: discord.Member):
    """Says when a member joined."""
    # Joined at can be None in very bizarre cases so just handle that as well
    if member.joined_at is None:
        await ctx.send(f'{member} has no join date.')
    else:
        await ctx.send(f'{member} joined {discord.utils.format_dt(member.joined_at)}')

@bot.command()
async def meme(ctx):
    imagenes = os.listdir('images')
    with open(f'images/{random.choice(imagenes)}', 'rb') as f:
        picture = discord.File(f)
    await ctx.send(file=picture)

def get_duck_image_url():    
    url = 'https://random-d.uk/api/random'
    res = requests.get(url)
    data = res.json()
    return data['url']


@bot.command('duck')
async def duck(ctx):
    '''Una vez que llamamos al comando duck, 
    el programa llama a la función get_duck_image_url'''
    image_url = get_duck_image_url()
    await ctx.send(image_url)

def dogs_image_url():
    url = "https://random.dog/woof.json"
    res = requests.get(url)
    data = res.json()
    return data["url"]

@bot.command("dog")
async def dog(ctx):
    image_url = dogs_image_url()
    await ctx.send(image_url)

@bot.command()
async def haces_algo_mas(ctx):
    await ctx.send(f"por ahora solo hago esto, soy un bot en proceso, accede a mis funciones escribiendo 'funciones' ")

@bot.command()
async def funciones(ctx):
    await ctx.send(f"Mis funciones son las siguientes: puedo sumar, decir cuando te uniste al servidor, elegir entre opciones, enviar fotos random de patos y perros, repetir palabras y saludar")

bot.run("")
